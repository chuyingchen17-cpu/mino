NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://mino:mino_dev_only@127.0.0.1:5432/mino
DEV_BOOTSTRAP_ENABLED=true
MODEL_PROVIDER=mock
# Base64 encoding of exactly 32 random bytes. Required in production. When omitted
# in development, Mino derives a stable local-only key from DATABASE_URL.
# LETTER_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# MODEL_BASE_URL=https://your-openai-compatible-provider.example/v1
# MODEL_API_KEY=
# MODEL_NAME=
