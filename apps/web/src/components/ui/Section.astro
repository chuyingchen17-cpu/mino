---
/**
 * 统一 Section 纵向节奏、底色与标题层级。
 * 每个 Section 只声明语义（id、标题、说明），不自己定义间距。
 */
import Container from './Container.astro';

interface Props {
  id?: string;
  /** canvas 是页面底色，sidebar 用于相邻 Section 之间的明暗交替。 */
  tone?: 'canvas' | 'sidebar';
  eyebrow?: string;
  heading?: string;
  body?: string;
  /** 标题区居中或左对齐。 */
  align?: 'left' | 'center';
  class?: string;
}

const {
  id,
  tone = 'canvas',
  eyebrow,
  heading,
  body,
  align = 'left',
  class: className = '',
} = Astro.props;

const tones = {
  canvas: 'bg-canvas',
  sidebar: 'bg-sidebar',
};
---

<section
  id={id}
  class={`scroll-mt-20 py-(--spacing-section) lg:py-(--spacing-section-lg) ${tones[tone]} ${className}`}
>
  <Container>
    {
      (eyebrow || heading || body) && (
        <div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
          {eyebrow && (
            <p class="text-sm font-semibold tracking-wide text-coral">{eyebrow}</p>
          )}
          {heading && (
            <h2 class="mt-3 font-rounded text-[1.625rem] leading-[1.3] font-bold tracking-tight sm:text-3xl lg:text-4xl">
              {heading}
            </h2>
          )}
          {body && <p class="mt-4 text-base leading-relaxed text-muted text-pretty">{body}</p>}
        </div>
      )
    }
    <slot />
  </Container>
</section>
