---
/**
 * 「它不会做的事」。
 *
 * 这一块回答的是决定要不要装之前最后那点顾虑：它会不会烦我、会不会偷看我。
 * 内容全部对着 apps/macos 的源码核过，四条的验证依据写在 content/site.ts 的注释里。
 *
 * 三个刻意的取舍：
 * 1. 不用 Section。Section 只有 canvas / sidebar 两种底色，用于相邻区块明暗交替；
 *    往交替链里插一块会把后面所有区块的 tone 连锁翻转。这里直接用 bg-surface，
 *    它比 canvas 和 sidebar 都白，既跳出交替链，也符合「说否定句时更冷静」的意图。
 * 2. 整屏不出现主色。Section 的 eyebrow 固定 coral，也是不用它的原因之一；
 *    划掉的圈用 text-faint，说「不做什么」不该拿高饱和色去强调。
 * 3. 标题 class 手抄 Section 的一份，保证和其他区块的字号层级完全一致。
 */
import Container from '~/components/ui/Container.astro';
import Icon from '~/components/ui/Icon.astro';
import { notDoing } from '~/content/site';
---

<section
  id="not-doing"
  class="scroll-mt-20 bg-surface py-(--spacing-section) lg:py-(--spacing-section-lg)"
>
  <Container>
    <div class="max-w-2xl">
      <h2
        class="font-rounded text-[1.625rem] leading-[1.3] font-bold tracking-tight sm:text-3xl lg:text-4xl"
      >
        {notDoing.heading}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted text-pretty">{notDoing.body}</p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        notDoing.items.map((item) => (
          <li class="rounded-card border border-line bg-canvas p-5">
            <Icon name="ban" size={20} class="text-faint" />
            <h3 class="mt-4 text-base font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
