---
/**
 * 结尾 CTA。
 *
 * 只留一个按钮，指向页面内的安装区。这里原来并排放着「在 GitHub 上查看」，
 * 但这是整页转化率最高的位置，放外链等于把已经决定要装的人送走。
 * 想看源码的人在导航、Hero 和 Footer 都能找到入口。
 * 旁边那只挥手的狗用 wave clip，是页面上唯一一个纯装饰的播放器。
 */
import Button from '~/components/ui/Button.astro';
import Container from '~/components/ui/Container.astro';
import PetClipPlayer from '~/components/interactive/PetClipPlayer.astro';
import { finalCta } from '~/content/site';
---

{/*
  这里不用 Section：Section 的上 padding 会跟前一个区块（常见问题）的下 padding
  叠成双份，两个 --spacing-section-lg 就是 240px，中间像漏了一屏内容。
  自身不设底色，用的是 body 的 canvas；常见问题是 sidebar，
  两者之间因此有一道明暗差，正好收住页面，不需要额外加线。

  上 padding 给的是 Section 的一半左右，不能是 0：常见问题那 120px 下 padding
  长在它自己的深色底里，明暗分界线之上，canvas 这侧一点余量都不剩，
  卡片圆角会直接顶在分界线上。这里留出的是分界线到卡片之间的呼吸。
*/}
<section
  class="pt-12 pb-(--spacing-section) lg:pt-16 lg:pb-(--spacing-section-lg)"
>
  <Container>
    <div
      class="flex flex-col items-center gap-8 rounded-prominent border border-line bg-surface px-6 py-12 text-center shadow-card sm:px-12"
    >
      <PetClipPlayer
        character="maltese-white"
        clip="wave"
        size={140}
        preload={false}
        label="挥手的 Mino"
      />

      <div>
        <h2
          class="font-rounded text-[1.625rem] leading-[1.3] font-bold tracking-tight sm:text-3xl lg:text-4xl"
        >
          {finalCta.heading}
        </h2>
        <p class="mt-3 text-base text-muted">{finalCta.body}</p>
      </div>

      <Button href={finalCta.primaryCta.href} size="lg" data-track-cta="final">
        {finalCta.primaryCta.label}
      </Button>
    </div>
  </Container>
</section>
