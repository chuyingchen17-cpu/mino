# Copy to .dev.vars for `wrangler dev --local`. Never commit real values.
ENVIRONMENT=development
DEV_BOOTSTRAP_ENABLED=true

GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id

SESSION_TOKEN_PEPPER=replace-with-at-least-16-random-characters
LETTER_ENCRYPTION_KEY_V1=replace-with-a-versioned-32-byte-base64-key

# `local-mock` selects the deterministic local decision provider.
MODEL_PROVIDER_API_KEY=local-mock
MODEL_PROVIDER_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5-mini
